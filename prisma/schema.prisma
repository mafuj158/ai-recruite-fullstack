datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

// ----------------------------------------------------
// USER & ACCOUNTS
// ----------------------------------------------------

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  passwordHash       String
  role               Role              @default(CANDIDATE)
  isEmailVerified    Boolean           @default(false)
  emailVerifyToken   String?           @unique
  emailVerifyExpires DateTime?
  isOnboarded        Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  candidateProfile   CandidateProfile?
  employerProfile    EmployerProfile?

  @@map("users")
}

// ----------------------------------------------------
// PROFILES (Created upon Registration)
// ----------------------------------------------------

model CandidateProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  avatarUrl          String?
  phone              String?

  // Onboarding Core Relations (Single Objects & Many-to-Many Skills)
  jobRoleId          String?
  jobRole            JobRole?  @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)

  industryId         String?
  industry           Industry? @relation(fields: [industryId], references: [id], onDelete: SetNull)

  skills             Skill[]

  // Other Onboarding Fields
  experienceLevel    String?
  workType           String?   // Remote, Hybrid, On-site
  preferredLocation  String?
  salaryExpectation  String?
  bio                String?

  // CV / Resume Info
  cvOption           String?   // upload | generate
  cvFileName         String?
  cvFileSize         String?
  cvUrl              String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("candidate_profiles")
}

model EmployerProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  companyName        String?
  logoUrl            String?
  website            String?

  // Relations & Core Onboarding Fields
  industryId         String?
  industry           Industry? @relation(fields: [industryId], references: [id], onDelete: SetNull)
  rolesHiringFor     JobRole[]

  companySize        String?
  location           String?
  aboutCompany       String?

  preferredExpLevels String[]  @default([])
  budgetRange        String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("employer_profiles")
}

// ----------------------------------------------------
// ADMIN CMS MASTER / LOOKUP TABLES
// ----------------------------------------------------

model JobRole {
  id         String             @id @default(cuid())
  label      String
  value      String             @unique
  isActive   Boolean            @default(true)
  candidates CandidateProfile[]
  employers  EmployerProfile[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@map("job_roles")
}

model Skill {
  id         String             @id @default(cuid())
  label      String
  value      String             @unique
  isPopular  Boolean            @default(false)
  isActive   Boolean            @default(true)
  candidates CandidateProfile[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@map("skills")
}

model Industry {
  id         String             @id @default(cuid())
  label      String
  value      String             @unique
  isActive   Boolean            @default(true)
  candidates CandidateProfile[]
  employers  EmployerProfile[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@map("industries")
}


