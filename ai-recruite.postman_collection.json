							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Registers a new Candidate or Employer. If role is EMPLOYER, companyName is optional."
					},
					"response": []
				},
				{
					"name": "login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.tokens) {",
									"        if (jsonData.data.tokens.access_token) {",
									"            pm.collectionVariables.set(\"token\", jsonData.data.tokens.access_token);",
									"        }",
									"        if (jsonData.data.tokens.refresh_token) {",
									"            pm.collectionVariables.set(\"refreshToken\", jsonData.data.tokens.refresh_token);",
									"        }",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"candidate@example.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Logs in user, returns access_token & refresh_token, and sets HTTP-only cookies. Auto-saves 'token' and 'refreshToken' variables on success."
					},
					"response": []
				},
				{
					"name": "refresh token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.tokens && jsonData.data.tokens.access_token) {",
									"        pm.collectionVariables.set(\"token\", jsonData.data.tokens.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/refresh",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"refresh"
							]
						},
						"description": "Generates a fresh access token using refresh token (from cookie or JSON body). Auto-updates 'token' variable."
					},
					"response": []
				},
